{
  "name": "yuvis-music",
  "version": "1.0.6",
  "description": "Yuvis音乐 - 一款克制、专注的 Windows 本地音乐播放器",
  "main": "src/main.js",
  "author": "Yuvis",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "check": "node --check src/main.js && node --check src/library-cache.js && node --check src/track-identity.js && node --check src/preload.js && node --check src/desktop-lyrics-preload.js && node --check src/desktop-lyrics.js && node --check src/game-lyrics-preload.js && node --check src/game-lyrics.js && node --check src/renderer.js && node --test tests/track-identity.test.js tests/library-cache.test.js",
    "checkpoint": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/checkpoint.ps1",
    "pack": "electron-builder --dir",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable-zip.ps1",
    "build:portable:single-exe": "electron-builder --win portable --config.artifactName=Yuvis-Music-${version}-${arch}-Portable-Single.${ext}"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "music-metadata": "^11.14.0"
  },
  "build": {
    "appId": "com.yidian.music",
    "productName": "Yuvis音乐",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "Yuvis-Music-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yuvis音乐",
      "uninstallDisplayName": "Yuvis音乐"
    }
  }
}
